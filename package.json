{
  "name": "image-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "prebuild": "node scripts/fetch-models.mjs",
    "build": "npm run assets:check && tsc -b && vite build && node scripts/check-bundle.mjs && node scripts/check-public-budget.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "perf:check": "node scripts/check-perf.mjs",
    "public:budget": "node scripts/check-public-budget.mjs",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "models:fetch": "node scripts/fetch-models.mjs",
    "assets:fetch": "node scripts/fetch-models.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "assets:check": "node scripts/verify-assets.mjs && node scripts/gen-luts.mjs --check && node scripts/gen-icons.mjs --check && node scripts/gen-look-thumbs.mjs --check",
    "appearance:sync": "vite-node scripts/sync-appearance.mjs",
    "luts:gen": "node scripts/gen-luts.mjs",
    "icons:gen": "node scripts/gen-icons.mjs",
    "thumbs:gen": "node scripts/gen-look-thumbs.mjs",
    "thumbs:check": "node scripts/gen-look-thumbs.mjs --check"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "@use-gesture/react": "^10.3.1",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "onnxruntime-web": "1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
